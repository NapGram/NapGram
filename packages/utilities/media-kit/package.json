{
  "name": "@napgram/media-kit",
  "version": "2.0.0",
  "description": "Media conversion utilities for NapGram",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "keywords": [
    "napgram",
    "media",
    "encoding"
  ],
  "author": "NapGram Team",
  "license": "MIT",
  "dependencies": {
    "@napgram/env-kit": "workspace:*",
    "@napgram/infra-kit": "workspace:*",
    "@napgram/logger-kit": "workspace:*",
    "file-type": "^22.0.0",
    "image-js": "^1.3.0",
    "silk-wasm": "^3.7.1"
  },
  "devDependencies": {
    "@types/node": "25.7.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
