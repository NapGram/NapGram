{
  "name": "@napgram/message-kit",
  "version": "2.0.1",
  "description": "Message conversion pipeline for NapGram",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "napgram",
    "message",
    "converter"
  ],
  "author": "NapGram Team",
  "license": "MIT",
  "dependencies": {
    "@mtcute/core": "^0.32.0",
    "@napgram/db-kit": "workspace:*",
    "@napgram/env-kit": "workspace:*",
    "@napgram/logger-kit": "workspace:*",
    "@napgram/media-kit": "workspace:*",
    "@napgram/qq-client": "workspace:*",
    "@napgram/runtime-kit": "workspace:*",
    "file-type": "^22.0.0",
    "image-js": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
