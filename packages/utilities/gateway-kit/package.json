{
  "name": "@napgram/gateway-kit",
  "version": "2.0.1",
  "description": "Gateway exports for NapGram",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@mtcute/core": "^0.32.1",
    "@mtcute/node": "^0.32.1",
    "@napgram/message-kit": "workspace:*",
    "@napgram/qq-client": "workspace:*",
    "@napgram/telegram-client": "workspace:*",
    "ws": "^8.18.3"
  },
  "keywords": [
    "napgram",
    "gateway"
  ],
  "author": "NapGram Team",
  "license": "MIT",
  "devDependencies": {
    "vitest": "5.0.0",
    "@types/node": "25.9.7",
    "@types/ws": "^8.18.1",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
