{
  "name": "@napgram/feature-kit",
  "version": "2.0.1",
  "description": "Feature wiring helpers for NapGram",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run"
  },
  "keywords": [
    "napgram",
    "feature"
  ],
  "author": "NapGram Team",
  "license": "MIT",
  "dependencies": {
    "@mtcute/core": "^0.29.7",
    "@mtcute/markdown-parser": "^0.29.7",
    "@mtcute/node": "^0.29.7",
    "@napgram/auth-kit": "workspace:*",
    "@napgram/db-kit": "workspace:*",
    "@napgram/env-kit": "workspace:*",
    "@napgram/infra-kit": "workspace:*",
    "@napgram/logger-kit": "workspace:*",
    "@napgram/media-kit": "workspace:*",
    "@napgram/message-kit": "workspace:*",
    "@napgram/plugin-kit": "workspace:*",
    "@napgram/qq-client": "workspace:*",
    "@napgram/runtime-kit": "workspace:*",
    "@napgram/telegram-client": "workspace:*",
    "file-type": "^22.0.0",
    "image-js": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
