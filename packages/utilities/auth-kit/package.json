{
  "name": "@napgram/auth-kit",
  "version": "2.0.1",
  "description": "Authentication utilities for NapGram",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "keywords": [
    "napgram",
    "auth"
  ],
  "author": "NapGram Team",
  "license": "MIT",
  "dependencies": {
    "@napgram/db-kit": "workspace:*",
    "@napgram/logger-kit": "workspace:*",
    "@napgram/qq-client": "workspace:*",
    "fastify": "5.8.5"
  },
  "devDependencies": {
    "vitest": "4.1.9",
    "@fastify/cookie": "^11.0.2",
    "@types/node": "25.9.4",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
