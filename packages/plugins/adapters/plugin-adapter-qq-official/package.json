{
  "name": "@napgram/plugin-adapter-qq-official",
  "version": "1.0.0",
  "description": "NapGram QQ official bot adapter (guild channel API)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "keywords": [
    "napgram",
    "plugin",
    "adapter",
    "qqofficial"
  ],
  "author": "NapGram Team",
  "license": "MIT",
  "dependencies": {
    "@napgram/qq-client": "workspace:*"
  },
  "devDependencies": {
    "@napgram/sdk": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
