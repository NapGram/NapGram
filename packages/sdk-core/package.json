{
  "name": "@napgram/sdk-core",
  "version": "2.0.0",
  "description": "TypeScript type definitions for NapGram native plugins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "napgram",
    "plugin",
    "types",
    "typescript"
  ],
  "author": "NapLink",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NapGram/sdk.git",
    "directory": "packages/sdk-core"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "registry": "https://gitlab.com/api/v4/projects/84583729/packages/npm/"
  }
}
