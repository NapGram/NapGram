{
  "name": "@napgram/database",
  "version": "2.0.0",
  "description": "Database abstraction layer for NapGram with Drizzle ORM",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./bun-sql": {
      "types": "./dist/bun-sql.d.ts",
      "import": "./dist/bun-sql.js",
      "default": "./dist/bun-sql.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "bun test --isolate --pass-with-no-tests src",
    "type-check": "tsc --noEmit",
    "db:generate": "bun --bun x drizzle-kit generate",
    "db:migrate": "bun --bun x drizzle-kit migrate",
    "db:push": "bun --bun x drizzle-kit push"
  },
  "keywords": [
    "napgram",
    "database",
    "orm",
    "drizzle"
  ],
  "author": "NapGram Team",
  "license": "MIT",
  "dependencies": {
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.8",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
