{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "gitlab>magisk3171/magisk-ci-toolkit"
  ],
  "baseBranchPatterns": [
    "beta"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": true,
  "prCreation": "immediate",
  "internalChecksFilter": "strict",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "customManagers": [
    {
      "description": "Keep the Dockerfile Bun version in sync with package.json's packageManager.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+extractVersion=(?<extractVersion>\\S+)\\s+ARG BUN_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Bump the Dockerfile Bun ARG together with the Bun packageManager version.",
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "oven-sh/bun"
      ],
      "groupName": "bun toolchain"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "recreateWhen": "always"
    },
    {
      "description": "Apply a 24h package cooldown before opening or automerging npm updates.",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "1 day"
    },
    {
      "enabled": false,
      "matchPackageNames": [
        "/^@napgram\\//",
        "/^@naplink\\//"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "addLabels": [
        "dependencies",
        "javascript"
      ]
    },
    {
      "matchPackageNames": [
        "@mtcute/**"
      ],
      "matchManagers": [
        "npm"
      ],
      "rangeStrategy": "bump"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "labels": [
      "security"
    ]
  }
}
