{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "forkProcessing": "enabled",
    "pruneStaleBranches": true,
    "pruneBranchAfterAutomerge": true,
    "baseBranchPatterns": [
        "dev"
    ],
    "dependencyDashboard": true,
    "dependencyDashboardOSVVulnerabilitySummary": "all",
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": false,
    "ignoreTests": true,
    "prCreation": "immediate",
    "internalChecksFilter": "strict",
    "minimumReleaseAgeBehaviour": "timestamp-required",
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": true,
            "automergeType": "pr",
            "recreateWhen": "always"
        },
        {
            "description": "Match pnpm's default 24h package cooldown before opening or automerging npm updates.",
            "matchDatasources": [
                "npm"
            ],
            "minimumReleaseAge": "1 day"
        },
        {
            "enabled": false,
            "matchPackageNames": [
                "/^@napgram\\//",
                "/^@naplink\\//"
            ]
        },
        {
            "matchManagers": [
                "npm"
            ],
            "addLabels": [
                "dependencies",
                "javascript"
            ]
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "addLabels": [
                "dependencies",
                "github_actions"
            ]
        },
        {
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "@mtcute/**"
            ],
            "rangeStrategy": "bump"
        },
        {
            "description": "Root pnpm overrides are maintained by dependency-force-manager.",
            "matchManagers": [
                "npm"
            ],
            "matchFileNames": [
                "package.json"
            ],
            "matchDepTypes": [
                "pnpm.overrides",
                "x-managedPnpmOverrides"
            ],
            "enabled": false
        },
        {
            "description": "Workspace pnpm overrides are maintained by dependency-force-manager.",
            "matchManagers": [
                "npm"
            ],
            "matchFileNames": [
                "pnpm-workspace.yaml"
            ],
            "enabled": false
        }
    ],
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "enabled": true,
        "automerge": true,
        "labels": [
            "security"
        ]
    },
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true
    }
}
