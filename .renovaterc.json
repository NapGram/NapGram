{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "baseBranchPatterns": [
        "dev"
    ],
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "all non-major dependencies",
            "groupSlug": "all-minor-patch",
            "matchPackageNames": [
                "*"
            ]
        },
        {
            "enabled": false,
            "matchPackageNames": [
                "/^@napgram//"
            ]
        },
        {
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "@mtcute/**"
            ],
            "rangeStrategy": "bump"
        }
    ]
}
