{
  "name": "@napgram/app",
  "type": "module",
  "version": "1.0.0",
  "files": [
    "assets",
    "build"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch --ignore=data/** src/index.ts",
    "dev:container": "bun src/index.ts",
    "build": "bun build.ts",
    "check:bundle": "bun tools/check-built-bundle.mjs",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --config=../oxlint.json --format=github src tools",
    "lint:fix": "oxlint --config=../oxlint.json --fix src tools",
    "start": "bun --enable-source-maps build/index.js",
    "test": "bun test --isolate src test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --isolate --coverage --coverage-reporter=lcov",
    "test:coverage:ci": "bun test --isolate --coverage --coverage-reporter=lcov --timeout 15000 && bun tools/check-coverage.ts",
    "dev:bun": "bun --watch --ignore=data/** src/index.ts",
    "start:bun": "bun --enable-source-maps build/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "10.1.3",
    "@kitajs/html": "^4.2.13",
    "@mtcute/bun": "^0.32.0",
    "@mtcute/core": "^0.32.0",
    "@mtcute/dispatcher": "^0.32.0",
    "@mtcute/markdown-parser": "^0.32.0",
    "@napgram/auth-kit": "workspace:*",
    "@napgram/builtins": "workspace:*",
    "@napgram/database": "workspace:*",
    "@napgram/db-kit": "workspace:*",
    "@napgram/env-kit": "workspace:*",
    "@napgram/gateway-kit": "workspace:*",
    "@napgram/infra-kit": "workspace:*",
    "@napgram/logger-kit": "workspace:*",
    "@napgram/marketplace-kit": "workspace:*",
    "@napgram/media-kit": "workspace:*",
    "@napgram/message-kit": "workspace:*",
    "@napgram/plugin-kit": "workspace:*",
    "@napgram/qq-client": "workspace:*",
    "@napgram/request-kit": "workspace:*",
    "@napgram/runtime-kit": "workspace:*",
    "@napgram/telegram-client": "workspace:*",
    "@napi-rs/image": "1.14.0",
    "@naplink/naplink": "^1.2.0",
    "drizzle-kit": "^0.31.10",
    "fastify": "^5.8.5",
    "fflate": "^0.8.2",
    "file-type": "^22.0.1",
    "silk-wasm": "^3.7.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kitajs/ts-html-plugin": "^4.1.4",
    "@mtcute/web": "^0.32.0",
    "@types/ejs": "^3.1.5",
    "@types/markdown-escape": "^1.1.3",
    "@types/tmp": "^0.2.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bun-types": "1.4.0",
    "fast-check": "^4.8.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
