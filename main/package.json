{
  "name": "@napgram/app",
  "type": "module",
  "version": "1.0.0",
  "files": [
    "assets",
    "build"
  ],
  "engines": {
    "node": ">=26.0.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch --ignore=data/** src/index.ts",
    "dev:container": "bun src/index.ts",
    "build": "bun build.ts",
    "check:bundle": "bun tools/check-built-bundle.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "start": "bun --enable-source-maps build/index.js",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:ui": "bun --bun vitest --ui",
    "test:coverage": "bun --bun vitest run --coverage.provider=istanbul",
    "test:coverage:ci": "bun --bun vitest run --coverage.provider=istanbul --maxWorkers=4 --testTimeout=15000 --hookTimeout=30000",
    "import": "ts-node tools/import",
    "dev:bun": "bun --watch --ignore=data/** src/index.ts",
    "start:bun": "bun --enable-source-maps build/index.js"
  },
